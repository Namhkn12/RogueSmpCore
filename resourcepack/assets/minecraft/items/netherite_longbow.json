{
  "hand_animation_on_swap": true,
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        { "when": "gui",   "model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon" } },
        { "when": "ground","model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon" } },
        { "when": "fixed", "model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon" } }
      ],
      "fallback": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow" }
    },
    "on_true": {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:use_duration",
      "scale": 0.05,
      "entries": [
        {
          "threshold": 0.65,
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              { "when": "gui",   "model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon_pulling_1" } },
              { "when": "ground","model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon_pulling_1" } },
              { "when": "fixed", "model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon_pulling_1" } }
            ],
            "fallback": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_pulling_1" }
          }
        },
        {
          "threshold": 0.9,
          "model": {
            "type": "minecraft:select",
            "property": "minecraft:display_context",
            "cases": [
              { "when": "gui",   "model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon_pulling_2" } },
              { "when": "ground","model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon_pulling_2" } },
              { "when": "fixed", "model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon_pulling_2" } }
            ],
            "fallback": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_pulling_2" }
          }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "property": "minecraft:display_context",
        "cases": [
          { "when": "gui",   "model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon_pulling_0" } },
          { "when": "ground","model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon_pulling_0" } },
          { "when": "fixed", "model": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_icon_pulling_0" } }
        ],
        "fallback": { "type": "minecraft:model", "model": "minecraft:item/bow/netherite_longbow_pulling_0" }
      }
    }
  }
}
