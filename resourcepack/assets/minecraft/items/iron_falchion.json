{
  "hand_animation_on_swap": true,
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/iron/iron_falchion_icon"
        }
      },
      {
        "when": "fixed",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/iron/iron_falchion_icon"
        }
      },
      {
        "when": "ground",
        "model": {
          "type": "minecraft:model",
          "model": "minecraft:item/iron/iron_falchion_icon"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/iron/iron_falchion"
    }
  }
}
